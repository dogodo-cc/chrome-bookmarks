{
  "manifest_version": 3,
  "name": "Better-Bookmarks",
  "version": "1.1.0",
  "description": "一个以无限画布平铺展示的书签管理器",
  "permissions": ["bookmarks", "storage", "contextMenus"],
  "icons": {
    "16": "icons/icon-v2-16.png",
    "48": "icons/icon-v2-48.png",
    "128": "icons/icon-v2-128.png"
  },
  "chrome_url_overrides": {
    "bookmarks": "bookmarks.html"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
